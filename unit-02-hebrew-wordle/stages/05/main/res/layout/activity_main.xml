<?xml version="1.0" encoding="utf-8"?>
<!-- המסך: LinearLayout אנכי. הרכיבים מסודרים מלמעלה למטה, בסדר שבו הם כתובים -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_padding"
        android:gravity="center"
        android:text="@string/title"
        android:textColor="@color/primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/msg_start"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <!-- הלוח: ריק כאן, את 30 האריחים בונים בקוד. weight=1 נותן לו את כל הגובה שנשאר -->
    <LinearLayout
        android:id="@+id/boardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical" />

    <!-- המקלדת יושבת בקובץ משלה, keyboard.xml, ו-include מכניס אותה לכאן -->
    <include
        layout="@layout/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding" />

</LinearLayout>
